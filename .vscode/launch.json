{
  "version": "0.2.0",
  "configurations": [
    { "name": "Generate small dataset (200)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_data.py",
      "args": ["--samples", "200", "--out", "data/small.npz"], "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Check dataset", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/scripts/check_dataset.py", "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Run baselines (random split)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/scripts/run_baselines.py", "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Run baselines (topology split)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/scripts/run_baselines.py",
      "args": ["--split", "topology"], "cwd": "${workspaceFolder}", "console": "integratedTerminal" }
  ]
}
